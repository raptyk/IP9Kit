{
  "name": "IP9Kit",
  "version": "1.0.0",
  "description": "Shared core of the IP9 apps for M5Stack Cardputer and Cardputer ADV: app shell with screen stack, status bar and toasts, list / carousel / help / dialog screens, keyboard events, status LED, battery and backlight.",
  "keywords": "cardputer, m5stack, esp32-s3, ui, framework",
  "homepage": "https://cardputer.ip9.pl",
  "repository": {
    "type": "git",
    "url": "https://github.com/raptyk/IP9Kit.git"
  },
  "authors": [
    {
      "name": "Patryk Strzelecki",
      "email": "patryk@strzelecki.info",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "dependencies": {
    "m5stack/M5Cardputer": "*"
  },
  "build": {
    "flags": "-std=gnu++17",
    "unflags": "-std=gnu++11"
  }
}
